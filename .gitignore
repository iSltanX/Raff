DerivedData/
*.xcuserdatad/
xcuserdata/

# Archives
*.zip

# Preview, debug, tmp and scratch files
*.log
*.tmp
/preview/
/debug/
/tmp/
/scratch/

# Working files: kept on the maintainer's disk (working rules, status, decisions,
# Figma→code map, reporting spec, test matrix, local preview config), not in the
# public tree.
.claude/
/CLAUDE.md
/docs/internal/
